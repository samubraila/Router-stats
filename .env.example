# Kopieren nach .env und ausfüllen:  cp .env.example .env

# FRITZ!Box-Adresse und Login. Der Benutzername steht unter System > FRITZ!Box-Benutzer.
# Bei Login nur mit Passwort ist es ein automatisch erzeugter Name wie "fritz1234"
# (anzeigen mit: curl http://192.168.178.1/login_sid.lua?version=2).
FRITZ_HOST=192.168.178.1
FRITZ_USER=
FRITZ_PASSWORD=

# Port des Dashboards auf dem Rechner (http://localhost:8090)
WEB_PORT=8090

# Sekunden zwischen schnellen Messungen: Traffic, Ping, DSL-Werte
POLL_INTERVAL=30
# Sekunden zwischen langsamen Abfragen: Geräteliste, WLAN-Details, Firmware
SLOW_INTERVAL=300
# Minuten zwischen automatischen Speedtests (0 = aus). Ein Test lädt ca. 35 MB.
SPEEDTEST_INTERVAL_MIN=60
SPEEDTEST_DOWN_MB=25
SPEEDTEST_UP_MB=10

PING_TARGETS=1.1.1.1,8.8.8.8
RETENTION_DAYS=30
TZ=Europe/Berlin
